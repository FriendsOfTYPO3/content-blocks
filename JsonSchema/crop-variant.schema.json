{
  "$schema": "http://json-schema.org/draft-07/schema",
  "$id": "http://typo3.org/crop-variant.json",
  "title": "Crop Variant",
  "description": "TYPO3 CMS Content Blocks Crop Variant",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "identifier"
  ],
  "properties": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "description": "Unique identifier for the Crop Variant."
    },
    "title": {
      "type": "string"
    },
    "allowedAspectRatios": {
      "type": "object",
      "patternProperties": {
        ".*": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "title": {
              "type": "string"
            },
            "value": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9]+\\s*\\/\\s*[0-9]+$"
                },
                {
                  "type": "number"
                }
              ]
            }
          },
          "required": [
            "value"
          ]
        }
      }
    },
    "coverAreas": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "width": {
            "type": "number"
          },
          "height": {
            "type": "number"
          }
        }
      }
    },
    "focusArea": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "type": "number"
        },
        "height": {
          "type": "number"
        }
      }
    },
    "cropArea": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "type": "number"
        },
        "height": {
          "type": "number"
        }
      }
    },
    "selectedRatio": {
      "type": "string"
    },
    "excludeFromSync": {
      "type": "boolean"
    },
    "disabled": {
      "type": "boolean",
      "const": true
    }
  }
}